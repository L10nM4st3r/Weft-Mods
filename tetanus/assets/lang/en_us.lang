mod.tetanus.name = Tetanus
mod.tetanus.description = Adds thirst and temperature mechanics to weft.
    Credit of this name goes to "fyrstikkeske".
    Don't step on a rusty nail.
mod.tetanus.authors = L10nM4st3r


command.tetanus.temperature = Set temperature to {0}°C
command.tetanus.hydrate = Set thirst to {0}


death.tetanus.dehydrate = {0} forgot to hydrate
death.tetanus.heat_exhaustion = {0} died of heat stroke
death.tetanus.incinerated = {0} went up in flames
death.tetanus.melted = {0} discovered the melting point of skin
death.tetanus.hypothermia = {0} felt a little chilly

config.core.damage.tetanus.dehydrate = Dehydration
config.core.damage.tetanus.heat_exhaustion = Heat Exhaustion
config.core.damage.tetanus.hypothermia = Hypothermia
config.core.damage.tetanus.incinerated = Incinerating Heat
config.core.damage.tetanus.melted = Melting Heat
config.core.damage.tetanus.dehydrate.tooltip = Part of Tetanus
config.core.damage.tetanus.heat_exhaustion.tooltip = Part of Tetanus
config.core.damage.tetanus.hypothermia.tooltip = Part of Tetanus
config.core.damage.tetanus.incinerated.tooltip = Part of Tetanus (damage dealt when temperature is more than 100 degrees Celsius).
config.core.damage.tetanus.melted.tooltip = Part of Tetanus (damage dealt when temperature is more than 600 degrees Celsius).


item.tetanus.empty_leather_canteen = Empty Leather Canteen
item.tetanus.filled_leather_canteen = Leather Canteen


tetanus.debug_temperature = Temperature (Body: {0}, Environment: {1}, Overlay Frame: {2})
tetanus.debug = Tetanus


config.tetanus.thirst_rate = Thirst Rate
config.tetanus.thirst_rate.tooltip = The higher this is, the faster they will dehydrate.
    (Default: 1.0)

config.tetanus.temperature_rate = Temperature Change Rate
config.tetanus.temperature_rate.tooltip = The higher this is, the faster the player's temperature will shift to match their environment.
    (Default: 1.0)

config.tetanus.thirst_enabled = Thirst Enabled
config.tetanus.thirst_enabled.tooltip = Disable this if you would not like to worry about thirst/dehydration mechanics.
    (Default: On)

config.tetanus.temperature_enabled = Temperature Enabled
config.tetanus.temperature_enabled.tooltip = Disable this if you would not like to worry about temperature mechanics.
    (Default: On)

config.tetanus.temperature_update_frequency = Temperature Update Frequency
config.tetanus.temperature_update_frequency.tooltip = The frequency - in ticks - that player temperature is updated. The higher this is, the lower the lag, but the more delayed updating is when changing environment.
    (Default: 60)





